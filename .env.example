# Copy this file to .env and adjust the values.  (Windows: copy .env.example .env)
# .env is git-ignored; never commit real secrets.

# Long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-long-random-string

# True for local development. With DEBUG=False, SECRET_KEY must be set.
DEBUG=True

# Comma-separated. Add your PC's LAN IP (e.g. 192.168.1.20) to test from a phone.
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Base URL encoded into table QR codes ({SITE_BASE_URL}/t/<public_id>/).
# Use your LAN IP here if phones will scan the printed table codes.
SITE_BASE_URL=http://127.0.0.1:8000

# Shared secret a camera / computer-vision service sends as "Authorization: Token <value>"
# to POST /api/v1/detections/. No vision model ships with RestaurantSpy.
DETECTION_API_TOKEN=change-me-detection-token

# Password given to the demo accounts created by "python manage.py seed_demo".
DEMO_PASSWORD=RestaurantSpy@2026

# Optional
TIME_ZONE=Asia/Kolkata
# SQLite file for this branch (the EquipWatch main branch uses db.sqlite3).
DATABASE_FILE=restaurantspy.sqlite3
APP_NAME=RestaurantSpy
COLLEGE_NAME=
TEAM_NAMES=
