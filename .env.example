# Copy this file to .env and adjust the values.  (Windows: copy .env.example .env)
# .env is git-ignored; never commit real secrets.

# Long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-long-random-string

# True for local development. With DEBUG=False, SECRET_KEY must be set.
DEBUG=True

# Comma-separated. Add your PC's LAN IP (e.g. 192.168.1.20) to test from a phone.
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Base URL encoded into equipment QR codes ({SITE_BASE_URL}/e/<public_id>/).
# Use your LAN IP here if phones will scan the printed labels.
SITE_BASE_URL=http://127.0.0.1:8000

# Shared secret the sensor simulator sends as "Authorization: Token <value>".
SIMULATOR_TOKEN=change-me-simulator-token

# Password given to the demo accounts created by "python manage.py seed_demo".
DEMO_PASSWORD=EquipWatch@2026

# Optional
TIME_ZONE=Asia/Kolkata
OFFLINE_AFTER_SECONDS=30
APP_NAME=EquipWatch
COLLEGE_NAME=
TEAM_NAMES=
